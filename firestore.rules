rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Subscribers collection
    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() > 5;
      allow read: if true;
      allow update, delete: if true;
    }

    // Donations collection
    match /donations/{donationId} {
      allow create: if request.resource.data.amount is number && request.resource.data.amount > 0;
      allow read: if true;
      allow update, delete: if true;
    }

    // Site settings & countdown configuration
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
